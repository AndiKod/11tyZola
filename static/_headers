# ==============================================================================
# Assets Caching (Performance)
# Cache immutable static assets for 1 year to maximize speed and Lighthouse score
# ==============================================================================

/main.css
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable


# ==============================================================================
# Security Headers (Applied to all routes)
# ==============================================================================

/*
  # Prevents clickjacking by forbidding embedding inside iframes
  X-Frame-Options: DENY

  # Prevents browsers from MIME-sniffing a response away from the declared content-type
  X-Content-Type-Options: nosniff

  # Controls how much referrer information is sent when navigating away
  Referrer-Policy: strict-origin-when-cross-origin

  # Disables access to sensitive hardware features by default
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Enforces strict HTTPS connections (uncomment if domain always uses HTTPS)
  # Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy (CSP)
  # Optimized for Zola (native SASS) + Alpine.js + CUBE CSS methodology
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:;
